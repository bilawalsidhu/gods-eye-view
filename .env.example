# Local development uses one file for browser and server keys.
# Copy to .env (ignored); this example contains names and placeholders only.
# Only explicitly selected browser keys are injected into the client bundle.
# OnDemand Spatial — environment variables
# Copy to .env and fill in your keys. On macOS the launcher can also read keys
# from the Keychain (see README); on Linux/Windows use this file or env vars.
#
# Easiest path: don't edit anything. Run the app and paste keys into the
# in-app Provider Settings panel (the POWER UP chip, bottom-right) — it writes
# this checkout's .env for you (owner-only permissions) and restarts the dev
# server. Under the Pinokio launcher it writes pinokio/ENVIRONMENT instead.
# Keys you supply yourself (shell env, Keychain) are shown as configured
# externally and never touched. This file remains the reference for headless
# and self-hosted setups.
#
# NOTE ON CLIENT-EXPOSED KEYS: GOOGLE_MAPS_API_KEY and CESIUM_ION_TOKEN are
# injected into the browser bundle by design (they're used client-side) and
# WILL be visible in devtools. Restrict/scope them rather than trying to hide
# them (see SECURITY.md). All other keys below stay server-side.

# Optional: direct Google Photorealistic 3D Tiles and GEV place search.
# Without it, a Cesium ion token can still load ion-hosted Google 3D; with
# neither credential, the app starts on keyless Esri World Imagery with OSM
# available in the map tray and as the automatic provider-failure fallback.
# CLIENT-EXPOSED — restrict it (HTTP referrer + API restriction) in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Optional: a SEPARATE Google API key for the SERVER-SIDE Google calls — Places
# (/api/google/nearby-places, /api/google/text-search) and the CCTV Street View
# fallback (#33). It never reaches the browser, so it can be restricted by
# server IP (not HTTP referrer) and scoped to just Places API + Street View
# Static API, letting the client-exposed key above stay narrowly scoped to Map
# Tiles + Geocoding. Unset, these calls fall back to GOOGLE_MAPS_API_KEY, so a
# single shared key keeps working — splitting is opt-in.
# SERVER-SIDE ONLY.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional: opt-in per-IP rate limit for the Google Places cost endpoint
# (/api/google/nearby-places), in requests per minute.
# DEFAULT IS UNLIMITED — unset (or 0) means no throttling, unchanged behavior.
# Set a positive integer to cap per-IP Places quota spend when self-hosting.
# Recommended whenever HOST is not localhost. NOTE: this is a per-IP,
# process-local guard (in-memory, resets on restart; over-limit requests get a
# sanitized 429) — it is NOT a billing cap. For hard spend protection set
# provider-side budget alerts: Google Cloud Console -> Billing -> Budgets & alerts
# (plus per-API quotas under APIs & Services -> Quotas).
# GEV_RATELIMIT_GOOGLE_PER_MIN=60

# Optional: Google Photorealistic 3D Tiles through Cesium ion, Bing world
# imagery, and Cesium World Terrain. The free Community plan is for eligible
# personal/non-commercial use and has quotas; check current Cesium terms. A
# direct Google key above is still required for GEV place search.
# CLIENT-EXPOSED — use a public assets:read token with URL restrictions.
CESIUM_ION_TOKEN=

# Optional: OpenAI Realtime voice control. Do not prefix with VITE_.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Cheaper voice tier, used when the GEV MIC panel's MINI toggle is on.
# Model ids and prices are external facts that drift — if OpenAI moves this id,
# override it here rather than editing src/voice/voiceCost.js.
OPENAI_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
# Keep only a short conversational window. Current map state is fetched live.
OPENAI_REALTIME_CONTEXT_TOKENS=3000
OPENAI_REALTIME_CONTEXT_RETENTION=0.5
OPENAI_HUD_SUMMARY_MODEL=gpt-5-nano
# Optional: opt-in per-IP rate limit for the OpenAI cost endpoints
# (/api/realtime/token + /api/openai/hud-summary), in requests per minute.
# DEFAULT IS UNLIMITED — unset (or 0) means no throttling, unchanged behavior.
# Set a positive integer to cap per-IP spend when self-hosting on a network.
# Recommended whenever HOST is not localhost. NOTE: this is a per-IP,
# process-local guard (in-memory, resets on restart; over-limit requests get a
# sanitized 429) — it is NOT a billing cap. For hard spend protection set a
# provider-side budget: OpenAI platform -> Settings -> Limits (usage limits).
# GEV_RATELIMIT_OPENAI_PER_MIN=30

# ── Live Flights (OpenSky) ─────────────────────────────────────────────────
# Optional: OpenSky auth mode (oauth | basic | auto | anon)
# Default: oauth — requires client credentials below; without credentials the
# proxy falls back to anonymous requests (400 credits/day, 10 s resolution).
OPENSKY_AUTH_MODE=oauth

# Optional: OpenSky OAuth2 client credentials (opensky-network.org → Account →
# API client). The proxy POSTs grant_type=client_credentials to
# https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
# and caches the bearer token in module scope (~30 min, single in-flight refresh).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Scene box requested per view: half-width in degrees around the camera anchor
# (3°×3° = 1 anonymous credit; the old worldwide request cost 4 and was ~8 MB).
# OPENSKY_BBOX_DEGREES=1.5
# Per-attempt timeout (ms) and extra attempts. opensky-network.org black-holes
# cloud egress (Vercel/AWS) with a CONNECT timeout — verified 2026-09-18 — so a
# single short probe is all the proxy spends before it opens the breaker below.
# OPENSKY_TIMEOUT_MS=6000
# OPENSKY_RETRIES=0
# After a timeout/network error OpenSky is bypassed for this long (ms); the
# regional fallbacks answer instead and the row reads DEGRADED with the reason.
# OPENSKY_BREAKER_MS=600000
# Regional fallback radius (nm, max 250) around the view anchor for
# api.adsb.lol /v2/lat/{lat}/lon/{lon}/dist/{nm} and opendata.adsb.fi.
# OPENSKY_FALLBACK_RADIUS_NM=250
# Opt-in LAST fallback for both flight layers: api.airplanes.live answers 403
# without prior approval (contact@airplanes.live), so it is off by default.
# AIRPLANES_LIVE_ENABLED=false

# Optional: higher Launch Library 2 request allowance. Public access works
# without a token.
LL2_API_TOKEN=

# Optional: OpenSky credentials JSON file path (alternative to above)
# OPENSKY_CREDENTIALS_FILE=/path/to/credentials.json

# Optional: dev server config
PORT=4173
# Network binding. Default is localhost — the server is reachable ONLY from
# this machine. This is the safe default: the dev server brokers your
# configured API keys, so anyone who can reach it can spend your quota.
# LAN opt-in: set HOST=0.0.0.0 to share on your local network. WARNING: that
# exposes every key-brokering proxy to everyone on the network — use only on
# networks you trust, and consider the GEV_RATELIMIT_* throttles above.
# HOST=localhost
# HOST=0.0.0.0

# Optional: NASA FIRMS live active fires. SERVER-SIDE ONLY (never reaches the
# browser — the client polls the /api/firms proxy). Free key:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without a key the FIRMS Active Fires layer is empty ("KEY REQUIRED").
# FIRMS_MAP_KEY=

# Optional: Live AIS vessels layer
# Browser fetch path. Keep same-origin so the private stream key stays server-side.
VITE_AIS_LIVE_API_URL=/api/ais-live
# Client render cap. The server can keep a larger AISStream cache, but drawing
# every global vessel at once can overwhelm WebGL on laptops.
VITE_AIS_LIVE_MAX_ROWS=12000
# Active label cap after screen-space clustering. Labels exist for all rendered
# ships, but only clustered winners are shown to keep text readable.
VITE_AIS_LIVE_LABEL_MAX_ROWS=900
# Private AISStream key for the server-side websocket. Do not prefix with VITE_.
AISSTREAM_API_KEY=
# Optional AISStream subscription filters.
# AISSTREAM_BOUNDING_BOXES=[[[-90,-180],[90,180]]]
# AISSTREAM_MESSAGE_TYPES=PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,ShipStaticData,StaticDataReport
# Feed watchdog: silence (ms) after which the feed is REPORTED stale; the socket
# is recycled at 2.5x that. Default 120000. The watchdog self-arms only for the
# default worldwide subscription — a narrow filter above can be legitimately
# quiet, so set this explicitly (sized for your filter) to opt back in.
# 0 disables the silence watch entirely.
# AISSTREAM_SILENCE_TIMEOUT_MS=120000
# Serverless (Vercel) AIS: there is no persistent relay — each poll of
# /api/ais-live?bbox= runs ONE bounded AISStream collection for the scene box
# (≤ AISSTREAM_COLLECT_MS, stops after AISSTREAM_COLLECT_QUIET_MS of silence
# once something arrived), then closes the socket; the snapshot is cached for
# AISSTREAM_SNAPSHOT_TTL_MS per 0.25° box (memory + edge s-maxage=30).
# AISSTREAM_COLLECT_MS=8000
# AISSTREAM_COLLECT_QUIET_MS=2500
# AISSTREAM_SNAPSHOT_TTL_MS=25000
# Optional shared snapshot cache across function instances (Vercel KV or any
# Upstash-compatible Redis REST endpoint; GET /get/{key}, POST /set/{key}?EX=120).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional keyless HTTP fallback (AISHub membership; 1 request/min, delayed
# positions). Without ANY key the serverless route serves a clearly labelled
# DEMO REPLAY of the Texas Gulf coast (Houston Ship Channel / Galveston Bay)
# and the DATA LAYERS row reads DEGRADED — never live AIS.
# AISHUB_USERNAME=

# ── Street Traffic (TomTom) ────────────────────────────────────────────────
# Optional: TomTom live traffic (BYOK freemium — get a key at
# https://developer.tomtom.com). SERVER-SIDE ONLY: the browser fetches
# same-origin /api/tomtom/* (flow vector tiles, Flow Segment Data
# /api/tomtom/flow-segment?point=lat,lon, /api/tomtom/status) and never sees
# the key. WITHOUT a key the layer still turns ON: live OSM roads with
# SIMULATED flow colours, and the DATA LAYERS row reads
# "DEGRADED · TomTom · TOMTOM_API_KEY not set — …" (never silently OFF).
TOMTOM_API_KEY=
# Daily soft caps (UTC): flow vector tiles (free tier ~50,000/day) and non-tile
# Flow Segment requests (status probes + /flow-segment; free tier 2,500/day).
# Over a cap the proxy serves last-good/stale instead of hitting upstream.
# TOMTOM_DAILY_TILE_BUDGET=40000
# TOMTOM_DAILY_REQUEST_BUDGET=2000

# ── Street Traffic road network (OSM via Overpass) ─────────────────────────
# The Street Traffic layer paints its (live or simulated) flow on OpenStreetMap
# roads fetched through the same-origin /api/overpass proxy, which POSTs the
# form-encoded query (`data=<Overpass QL>`) to public Overpass mirrors with
# `User-Agent: ondemand-spatial/<major.minor> (+repo URL)` and
# `Accept: application/json`, and rotates to the next mirror on HTTP 406 / 429
# / any 5xx, a rate-limit or runtime-error body, a network error or a timeout.
# OVERPASS_ENDPOINTS: comma-separated mirror URLs in priority order (entries
# are trimmed, empty entries ignored, duplicates collapse). Unset = the default
# below, ordered by the reachability probe of 2026-09-19 (kumi.systems and
# private.coffee answer; overpass-api.de and its lz4./z. aliases answer HTTP
# 406 to cloud/sandbox egress and are kept LAST rather than dropped).
# `OVERPASS_UPSTREAMS` (2026-09-18) is the accepted alias of the same setting.
# When EVERY mirror fails the proxy answers a structured HTTP 503 and the DATA
# LAYERS row reads "DEGRADED · Overpass · all 5 mirrors failed · last: <mirror>
# HTTP 406" (never UNAVAILABLE, never a raw 502). The durable fix for cloud
# egress is a self-hosted / private Overpass instance listed FIRST here.
# OVERPASS_ENDPOINTS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter
# Per-mirror HTTP budget (ms, 1000–60000; default 12000) and the whole-rotation
# budget across all mirrors (ms, 2000–120000; default 40000) — both sized so a
# full rotation finishes inside the 60 s serverless function ceiling. The road
# query itself carries an explicit `[timeout:20]`.
# OVERPASS_MIRROR_TIMEOUT_MS=12000
# OVERPASS_TOTAL_TIMEOUT_MS=40000
# ROAD_NETWORK_SOURCE=overpass   # or `off` to disable the OSM road fetch entirely

# Optional: CCTV layer tuning (advanced). Defaults are sensible — leave unset
# unless you're customizing the camera source pack.
# CCTV_SOURCES_FILE=config/cctv_sources.austin.json   # path to a source-pack JSON
# CCTV_SOURCES_JSON=                                   # inline source-pack JSON (overrides file)
# CCTV_AUSTIN_ROWS_URL=                                # override the Austin Open Data catalog URL
# CCTV_AUSTIN_MAX_SOURCES=250                          # cap cameras loaded from the Austin catalog
# CCTV_CALTRANS_DISTRICTS=4,7,11,3                     # Caltrans districts; empty string disables Caltrans
# CCTV_CALTRANS_MAX_SOURCES=300                        # cap cameras loaded from Caltrans
# CCTV_TFL_ENABLED=1                                   # set 0 to disable Transport for London JamCams
# CCTV_TFL_MAX_SOURCES=250                             # cap cameras loaded from TfL
# CCTV_ONTARIO_ENABLED=1                               # set 0 to disable Ontario 511 cameras
# CCTV_ONTARIO_MAX_SOURCES=1000                        # cap cameras loaded from Ontario 511
# CCTV_FINTRAFFIC_ENABLED=1                            # set 0 to drop the Fintraffic (Finland) pack
# CCTV_FINTRAFFIC_MAX_SOURCES=300                      # cap cameras loaded from the Fintraffic catalog
# CCTV_DRIVEBC_MAX_SOURCES=250                         # cap DriveBC (British Columbia) cameras, nearest Vancouver/Victoria first
# CCTV_DRIVEBC_ENABLED=1                               # 0 turns off the DriveBC camera pack
# CCTV_TXDOT_ENABLED=1                                 # set 0 to disable the TxDOT (Texas) pack
# CCTV_TXDOT_DISTRICTS=AUS,SAT                         # TxDOT district codes (25 exist); empty disables the pack
# CCTV_TXDOT_MAX_SOURCES=500                           # cap cameras loaded from the TxDOT catalogs
# CCTV_TALLINN_ENABLED=1                               # set 0 to disable the Tallinn (Estonia) intersection cameras
# CCTV_TALLINN_MAX_SOURCES=255                         # cap cameras loaded from the Tallinn catalog
# CCTV_TARKTEE_ENABLED=1                               # set 0 to disable the Tarktee (Estonia) road-weather cameras
# CCTV_TARKTEE_MAX_SOURCES=179                         # cap cameras loaded from Tarktee
# CCTV_WARENDORF_ENABLED=1                             # set 0 to disable the Warendorf (Germany) municipal webcams
# CCTV_NSW_ENABLED=1                                   # set 0 to disable the Live Traffic NSW (Australia) cameras
# CCTV_NSW_MAX_SOURCES=250                             # cap cameras loaded from Live Traffic NSW
# CCTV_CALGARY_ENABLED=1                               # set 0 to disable the Open Calgary (Alberta) cameras
# CCTV_CALGARY_MAX_SOURCES=220                         # cap cameras loaded from the Open Calgary catalog
# CCTV_CALGARY_ROWS_URL=                               # override the Open Calgary catalog URL
# CCTV_MAX_SOURCES=4000                                # catalog-wide ceiling, shared round-robin across packs
# CCTV_PREFER_AUSTIN=1                                 # prioritize Austin cameras in the registry
# CCTV_FORCE_AUSTIN=                                   # force live default sources when a source-pack JSON is configured

# ---- OnDemand serverless proxy (api/ondemand/*) — names only ----
# Server-side proxy to the OnDemand public API (docs.on-demand.io). Every
# name below stays server-side and is read once per function module load by
# server/ondemand/config.js (imported everywhere as api/ondemand/_config.js,
# the single config import point); NONE of these are ever sent to the
# browser. See docs/ONDEMAND_PROXY_DESIGN.md for the endpoint table, the
# full reconciliation table (canonical/alias/default precedence, added
# 2026-09-18), the env-var deny-list and its rationale, and the
# "not implemented because absent from the live docs" surfaces.
#
# ONDEMAND-ONLY: OnDemand is the ONLY AI / voice / reasoning provider behind
# api/ondemand/* — chat (sync + SSE), reasoning modes, speech-to-text,
# text-to-speech and the Agents Flow Builder workflow all go to
# api.on-demand.io with the single ONDEMAND_API_KEY above/below; no second
# LLM, TTS/STT or voice vendor key is read by this proxy (see DENIED below).
# The optional per-request key override — the `x-ondemand-key` REQUEST
# HEADER set by the client Settings drawer (kept in the browser's
# localStorage only) — is a header, never an environment variable: it is not
# listed in this file, is never persisted server-side, and the env key below
# remains the default when the header is absent.
#
# ── Vercel project ondemand-eand-spatial — env NAME audit (2026-09-18) ──
# Names only, no values (docs/ONDEMAND_PROXY_DESIGN.md §10.1 has the
# canonical → alias → default precedence; docs/ONDEMAND_API_CURRENT.md §18
# the live re-validation this audit was run against).
#   PRESENT on the project (18): ONDEMAND_SPATIAL_FLOW_VERSION,
#     ONDEMAND_REASONING_ENDPOINT_ID, ONDEMAND_SELFTEST_TOKEN,
#     GODS_EYE_FLOW_VERSION (alias of ONDEMAND_SPATIAL_FLOW_VERSION, checked
#     FIRST), ONDEMAND_FULFILLMENT_ENDPOINT_ID, VITE_SERVERLESS_MODE,
#     ONDEMAND_BASE_URL, ASK_ENABLED, ONDEMAND_API_KEY, CI, ONDEMAND_API_BASE
#     (alias of ONDEMAND_BASE_URL), ONDEMAND_ENDPOINT_ID (shared alias of
#     ONDEMAND_REASONING_ENDPOINT_ID and ONDEMAND_FULFILLMENT_ENDPOINT_ID),
#     ONDEMAND_REASONING_MODE, ASK_THE_DEAL_ALLOWED_ORIGIN,
#     DOC_BUSINESS_PLAN_URL, DOC_BUSINESS_PLAN_PDF_URL, DOC_MOU_URL,
#     DOC_GANTT_URL.
#   DEPRECATED / IGNORED — present on the project but NEVER read by this
#     code (deny-listed; enforced by server/ondemand/deny-list.test.mjs,
#     which greps api/ondemand/** and server/ondemand/*.js — this file is
#     deliberately outside that grep so the names can be spelled out here):
#     ONDEMAND_KNOWLEDGE_PLUGIN_IDS (retired alias — use
#     ONDEMAND_SPATIAL_AGENT_ID), ELEVENLABS_API_KEY (no secondary AI/voice
#     provider; setting it has no effect). Safe to delete from the project.
#   STILL MISSING on the project (add when the feature is wanted):
#     OPENSKY_CLIENT_ID, OPENSKY_CLIENT_SECRET (live flights, OAuth),
#     AISSTREAM_API_KEY (live AIS vessels), TOMTOM_API_KEY (street traffic),
#     optional KV_REST_API_URL / KV_REST_API_TOKEN (shared AIS snapshot
#     cache), ONDEMAND_SPATIAL_WORKFLOW_ID (canonical workflow-id name —
#     neither it nor its alias ONDEMAND_SPATIAL_FLOW_ID is set, so the
#     built-in default 6aace534859f7b0abb53d99a applies; that is correct
#     for this deployment and needs no action).

# Required to enable api/ondemand/*. Sent verbatim as the `apikey` header
# (docs.on-demand.io contract §1). Without it every /api/ondemand/* route
# returns 503 (health.js instead returns 200 with every field "not configured").
ONDEMAND_API_KEY=
# Optional. Root host for all four OnDemand API families; default
# https://api.on-demand.io. Override for a documented alternate host
# (e.g. a gateway-dev/api-dev sandbox) — never invent a path, only the host.
# alias accepted: ONDEMAND_API_BASE (used only when ONDEMAND_BASE_URL is
# unset; see docs/ONDEMAND_PROXY_DESIGN.md §5b)
ONDEMAND_BASE_URL=
# Optional. Default agent/plugin id(s) sent as `pluginIds` (contract
# §2.1/§3.1) when a request omits pluginIds entirely — comma/whitespace
# separated, capped at 20. Also surfaced as `plugins.<id>: 'not probed'` by
# /api/ondemand/health. NO ALIAS is accepted for this setting (see the
# DENIED note below) — this is the only supported name.
# Platform registration (2026-09-19): the OnDemand Spatial Intelligence Agent
# can only be created in the dashboard (READY_TO_PASTE.md §3 / §4.4), so
# this stays empty until a human pastes the returned pluginId here (and/or
# into src/registry/capabilities.json `ondemand.agent.pluginId`).
# /api/ondemand/health reports `config.spatialAgentId.source` =
# env | registration-pack | unset — presence/source only, never the value.
ONDEMAND_SPATIAL_AGENT_ID=
# Optional. pluginId of the `earthquake_search` REST agent (the tool built
# from docs/ondemand-workflows/tools/earthquake_search.openapi.json).
# Platform registration (2026-09-19): REST-tool creation is dashboard-only
# (the undocumented MCP/REST create surface answered HTTP 500 — see
# docs/registration/CREATION_LOG_2026-09-19.md §4), so this stays empty
# until READY_TO_PASTE.md §1 / §4.1 has been pasted and the dashboard
# returns the id. Fallback read from src/registry/capabilities.json
# `capabilities[id="earthquake.search"].ondemand_tool_id`;
# /api/ondemand/health reports `config.spatialToolId.source` =
# env | registration-pack | unset — presence/source only, never the value.
# NAME only here — never commit a value.
ONDEMAND_SPATIAL_TOOL_ID=
# Optional. Default workflow id for `POST {automation}/workflow/{id}/execute`
# (contract §7.1; re-validated live 2026-09-18, contract §18.2 a — the
# execute call takes ONLY the path id, no body/params) when a request omits
# workflowId. CANONICAL name: ONDEMAND_SPATIAL_WORKFLOW_ID (added 2026-09-18
# — the API calls the object a *workflow*). Accepted alias:
# ONDEMAND_SPATIAL_FLOW_ID (the name used since 2026-09-17; still honoured).
# Resolution order (server/ondemand/config.js WORKFLOW_ID_ENV, canonical
# first): ONDEMAND_SPATIAL_WORKFLOW_ID → ONDEMAND_SPATIAL_FLOW_ID → built-in
# default; /api/ondemand/health `config.spatialFlowId` reports which NAME
# resolved (`source`) and `resolvedVia: canonical | alias | default` — never
# the value. Set ONE of the two; if both are set the canonical wins.
# Built-in default (server/ondemand/config.js FLOW_DEFAULTS, re-exported by
# api/ondemand/_config.js): 6aace534859f7b0abb53d99a — the REAL id of
# "OnDemand Spatial Advanced Workflow" v1, created through the documented
# POST /automation/api/workflow/ (HTTP 201, 2026-09-18T07:16:04Z, as
# "GodsEye Advanced Spatial Workflow") and activated (HTTP 200,
# 2026-09-18T07:16:14Z); display name changed 2026-09-18T10:41:47Z via the
# documented PATCH /workflow/{id}/name (id unchanged); re-confirmed by
# GET /automation/api/workflow/{id} → 200 on 2026-09-18T16:20:55Z (the
# 26-character spelling "6aace534859f9f7b0abb53d99a" seen in one operator
# prompt is NOT a valid 24-hex id and answers 404 — never use it).
# Definition/export/node map in docs/ondemand-workflows/ (export:
# ondemand-spatial-advanced-v1.json). A workflow id is not a secret
# (useless without the api key). Leave as-is unless you re-import the
# workflow into another OnDemand company, which returns a new id.
ONDEMAND_SPATIAL_WORKFLOW_ID=6aace534859f7b0abb53d99a
# ONDEMAND_SPATIAL_FLOW_ID=6aace534859f7b0abb53d99a   # alias — same value, checked second
# Optional. Reconciled for env-name/health-reporting purposes only — the
# API has no separate "reasoning endpoint" concept (contract §12): this
# value is never sent upstream by any /api/ondemand/* handler. Default
# 'low' — a documented reasoningMode value (contract §3.1/§12), i.e. the
# default reasoningMode TIER, not an upstream call. The benchmarked
# ASK/INVESTIGATE/DEEP defaults (server/ondemand/config.js TIER_DEFAULTS,
# docs/ONDEMAND_PROXY_DESIGN.md §10.6, 2026-09-18) are ASK =
# predefined-gpt-5.6-luna + low, INVESTIGATE = predefined-claude-sonnet-5 +
# low, DEEP = predefined-claude-sonnet-5 + high; they are constants, not
# read from the environment.
# alias accepted: ONDEMAND_ENDPOINT_ID (used only when
# ONDEMAND_REASONING_ENDPOINT_ID is unset; see docs/ONDEMAND_PROXY_DESIGN.md
# "Environment name reconciliation (2026-09-18)")
ONDEMAND_REASONING_ENDPOINT_ID=
# Optional. Default `endpointId` (the fulfillment model) for /api/ondemand/chat
# when a request omits it (contract §3.1/§12). Default
# 'predefined-gpt-5.6-luna' (the ASK tier winner of the 2026-09-18 live
# benchmark: sync 4,189 ms / time-to-first-delta 1,880 ms, all candidates
# HTTP 200 — docs/audit/endpoint-benchmark.md) — ids are documented as
# volatile (§12), so this default may need revisiting as the predefined
# list changes; override here or per-request.
# alias accepted: ONDEMAND_ENDPOINT_ID (used only when
# ONDEMAND_FULFILLMENT_ENDPOINT_ID is unset; shared with
# ONDEMAND_REASONING_ENDPOINT_ID above — see docs/ONDEMAND_PROXY_DESIGN.md)
ONDEMAND_FULFILLMENT_ENDPOINT_ID=
# Optional. Free-string `reasoningMode` sent on STREAM chat queries only
# (contract §3.1/§12 — guide-only, not in the OpenAPI schema). Validated
# against a documented/observed tier-id list (server/ondemand/config.js's
# DOCUMENTED_REASONING_MODES — currently: low, high, grok-4-fast, dynamic,
# glm-4.7-flash, gemini-3-flash, gemini-3, deepseek-v3.1, haiku,
# glm-5-turbo, minimax-m2, gpt-5.4, gpt-5.4-pro, opus, kimi-k2); a value
# outside that list is replaced with the default tier ('dynamic') and
# flagged `reasoningModeInvalid: true` by /api/ondemand/health rather than
# forwarded blind. Leave unset to omit the field entirely (default
# behaviour, unaffected either way).
ONDEMAND_REASONING_MODE=
# Optional. Informational only — NEVER sent upstream by any handler.
# Workflow versioning is NOT FOUND IN LIVE DOCS (contract §7.3), so this is
# the repo's OWN version label of the workflow definition above
# ("OnDemand Spatial Advanced Workflow" v1,
# docs/ondemand-workflows/ondemand-spatial-advanced-v1.json). Default '1'
# (FLOW_DEFAULTS.flowVersion); bump together with the export.
# Accepted alias: GODS_EYE_FLOW_VERSION — checked FIRST (alias-first) so the
# value already provisioned on the Vercel project (env id usC3wgbut65gTkaR)
# keeps winning until it is migrated; /api/ondemand/health
# `config.flowVersion.source` names which one resolved (and
# `config.flowVersion.resolvedVia` says 'alias' | 'canonical' | 'default').
# Resolution order: GODS_EYE_FLOW_VERSION → ONDEMAND_SPATIAL_FLOW_VERSION →
# default '1' (server/ondemand/config.js FLOW_VERSION_ENV).
ONDEMAND_SPATIAL_FLOW_VERSION=1
# GODS_EYE_FLOW_VERSION=1
# Optional. Local proxy behaviour ONLY — NOT an OnDemand API field. Bounds
# every upstream fetch made by api/ondemand/* except the chat SSE stream
# (which instead aborts when the client disconnects). Default 60000 (60s).
ONDEMAND_REQUEST_TIMEOUT_MS=
# Optional. One-time token that enables GET /api/ondemand/selftest (a
# 10-step live contract smoke test, sessionIdHash only, no secrets in the
# response) — the route requires header `x-selftest-token` to equal this
# value (constant-time compare) and answers 404 otherwise (whether this is
# unset, or the header is missing/wrong). Rate-limited to once per 60s per
# warm instance. Leave unset to keep the route disabled (404 always).
ONDEMAND_SELFTEST_TOKEN=
# DENIED — never read by this proxy, on purpose (see
# docs/ONDEMAND_PROXY_DESIGN.md "Environment name reconciliation
# (2026-09-18)" for the full rationale; enforced by
# server/ondemand/deny-list.test.mjs). Setting either of these has NO
# effect: ONDEMAND_KNOWLEDGE_PLUGIN_IDS (retired alias — use
# ONDEMAND_SPATIAL_AGENT_ID above instead) and ELEVENLABS_API_KEY (no
# secondary AI/voice provider is used by this proxy).
# Client feature flag (src/serverlessMode.js), read at BUILD time by Vite.
# Set to `true` for a serverless (Vercel Functions) build: the browser bundle
# then skips the AISStream vessel relay and voice control (both need a
# long-running server) and shows the "Unavailable in serverless deployment"
# notice. Leave unset for the normal Vite dev server.
VITE_SERVERLESS_MODE=
# Server-side twin read by server/serverless/app.js (VERCEL=1, which Vercel
# sets automatically, implies it). Guards /api/ais-live and /api/realtime/token
# (501) and redirects .gev-cache writes to the OS temp dir.
SERVERLESS_MODE=
