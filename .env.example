# Local development uses one file for browser and server keys.
# Copy to .env (ignored); this example contains names and placeholders only.
# Only explicitly selected browser keys are injected into the client bundle.
# God's Eye View — environment variables
# Copy to .env and fill in your keys. On macOS the launcher can also read keys
# from the Keychain (see README); on Linux/Windows use this file or env vars.
#
# Easiest path: don't edit anything. Run the app and paste keys into the
# in-app Provider Settings panel (the POWER UP chip, bottom-right) — it writes
# this checkout's .env for you (owner-only permissions) and restarts the dev
# server. Under the Pinokio launcher it writes pinokio/ENVIRONMENT instead.
# Keys you supply yourself (shell env, Keychain) are shown as configured
# externally and never touched. This file remains the reference for headless
# and self-hosted setups.
#
# NOTE ON CLIENT-EXPOSED KEYS: GOOGLE_MAPS_API_KEY and CESIUM_ION_TOKEN are
# injected into the browser bundle by design (they're used client-side) and
# WILL be visible in devtools. Restrict/scope them rather than trying to hide
# them (see SECURITY.md). All other keys below stay server-side.

# Optional: direct Google Photorealistic 3D Tiles and GEV place search.
# Without it, a Cesium ion token can still load ion-hosted Google 3D; with
# neither credential, the app starts on keyless Esri World Imagery with OSM
# available in the map tray and as the automatic provider-failure fallback.
# CLIENT-EXPOSED — restrict it (HTTP referrer + API restriction) in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Optional: a SEPARATE Google API key for the SERVER-SIDE Google calls — Places
# (/api/google/nearby-places, /api/google/text-search) and the CCTV Street View
# fallback (#33). It never reaches the browser, so it can be restricted by
# server IP (not HTTP referrer) and scoped to just Places API + Street View
# Static API, letting the client-exposed key above stay narrowly scoped to Map
# Tiles + Geocoding. Unset, these calls fall back to GOOGLE_MAPS_API_KEY, so a
# single shared key keeps working — splitting is opt-in.
# SERVER-SIDE ONLY.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional: opt-in per-IP rate limit for the Google Places cost endpoint
# (/api/google/nearby-places), in requests per minute.
# DEFAULT IS UNLIMITED — unset (or 0) means no throttling, unchanged behavior.
# Set a positive integer to cap per-IP Places quota spend when self-hosting.
# Recommended whenever HOST is not localhost. NOTE: this is a per-IP,
# process-local guard (in-memory, resets on restart; over-limit requests get a
# sanitized 429) — it is NOT a billing cap. For hard spend protection set
# provider-side budget alerts: Google Cloud Console -> Billing -> Budgets & alerts
# (plus per-API quotas under APIs & Services -> Quotas).
# GEV_RATELIMIT_GOOGLE_PER_MIN=60

# Optional: Google Photorealistic 3D Tiles through Cesium ion, Bing world
# imagery, and Cesium World Terrain. The free Community plan is for eligible
# personal/non-commercial use and has quotas; check current Cesium terms. A
# direct Google key above is still required for GEV place search.
# CLIENT-EXPOSED — use a public assets:read token with URL restrictions.
CESIUM_ION_TOKEN=

# Optional: fully local voice + HUD summaries. Set AI_PROVIDER=ollama to
# replace OpenAI Realtime with a local pipeline: browser VAD -> faster-whisper
# (Python worker, scripts/local_audio.py) -> Ollama tool calling -> Piper TTS.
# Start with scripts/dev-local.ps1 (Windows) or scripts/dev-local.sh.
AI_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
# One resident model serves both voice tool-calling and the HUD summary.
# Measured 2026-09-16 on an RTX 5070 Ti with scripts/qa-tool-calls.mjs:
# qwen3:8b 11/12 correct, 300 ms median; qwen3:14b 11/12, 520 ms;
# qwen2.5:14b 11/12, 470 ms. Thinking is disabled automatically for qwen3.
OLLAMA_VOICE_MODEL=qwen3:8b
OLLAMA_HUD_MODEL=qwen3:8b
# Vision model for ask_about_view (screenshot questions). qwen3-vl:4b fits
# beside qwen3:8b and Whisper on a 16 GB GPU; set OLLAMA_MAX_LOADED_MODELS=2
# on the Ollama service so the two models stay resident together.
OLLAMA_VISION_MODEL=qwen3-vl:4b
# The system prompt plus 28 tool schemas is ~12k tokens; keep num_ctx above it.
OLLAMA_NUM_CTX=24576
OLLAMA_KEEP_ALIVE=30m
# Whisper: model name (small, medium, large-v3-turbo, distil-large-v3.5),
# device auto|cuda|cpu, and language code or auto. On a CUDA GPU
# large-v3-turbo transcribes a short command in ~120 ms (scripts/bench_stt.py);
# on CPU use small (~1.2 s). Auto falls back to CPU when VRAM is short.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
# auto picks CUDA only when at least this much VRAM is free at worker start
# (large-v3-turbo fp16 needs ~2 GB; the two Ollama models take ~10 GB).
WHISPER_MIN_FREE_VRAM_MB=2400
WHISPER_LANGUAGE=auto
# Piper voice name under .local/voices (download with
# python -m piper.download_voices --download-dir .local/voices <name>).
TTS_VOICE=en_US-ryan-high
# PIPER_MODEL=                      # absolute .onnx path; overrides TTS_VOICE
# PYTHON=                           # interpreter; defaults to .venv-local
VOICE_WS_PATH=/api/voice/ws
# Optional hands-free start: a free Picovoice AccessKey (console.picovoice.ai)
# and a built-in keyword (Computer, Jarvis, Porcupine, Bumblebee, ...). The key
# is used by the browser engine, so it is served to the page on purpose. Run
# `npm run wakeword:fetch` once to download the acoustic model.
# PICOVOICE_ACCESS_KEY=
# WAKE_WORD=Computer

# Optional: OpenAI Realtime voice control. Do not prefix with VITE_.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Cheaper voice tier, used when the GEV MIC panel's MINI toggle is on.
# Model ids and prices are external facts that drift — if OpenAI moves this id,
# override it here rather than editing src/voice/voiceCost.js.
OPENAI_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
# Keep only a short conversational window. Current map state is fetched live.
OPENAI_REALTIME_CONTEXT_TOKENS=3000
OPENAI_REALTIME_CONTEXT_RETENTION=0.5
OPENAI_HUD_SUMMARY_MODEL=gpt-5-nano
# Optional: opt-in per-IP rate limit for the OpenAI cost endpoints
# (/api/realtime/token + /api/openai/hud-summary), in requests per minute.
# DEFAULT IS UNLIMITED — unset (or 0) means no throttling, unchanged behavior.
# Set a positive integer to cap per-IP spend when self-hosting on a network.
# Recommended whenever HOST is not localhost. NOTE: this is a per-IP,
# process-local guard (in-memory, resets on restart; over-limit requests get a
# sanitized 429) — it is NOT a billing cap. For hard spend protection set a
# provider-side budget: OpenAI platform -> Settings -> Limits (usage limits).
# GEV_RATELIMIT_OPENAI_PER_MIN=30

# Optional: OpenSky auth mode (oauth | basic | auto | anon)
# Default: oauth — requires client credentials below
# Set to "anon" to skip aircraft auth (rate-limited but works)
OPENSKY_AUTH_MODE=oauth

# Optional: OpenSky OAuth credentials (from opensky-network.org account dashboard)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: higher Launch Library 2 request allowance. Public access works
# without a token.
LL2_API_TOKEN=

# Optional: OpenSky credentials JSON file path (alternative to above)
# OPENSKY_CREDENTIALS_FILE=/path/to/credentials.json

# Optional: dev server config
PORT=4173
# Network binding. Default is localhost — the server is reachable ONLY from
# this machine. This is the safe default: the dev server brokers your
# configured API keys, so anyone who can reach it can spend your quota.
# LAN opt-in: set HOST=0.0.0.0 to share on your local network. WARNING: that
# exposes every key-brokering proxy to everyone on the network — use only on
# networks you trust, and consider the GEV_RATELIMIT_* throttles above.
# HOST=localhost
# HOST=0.0.0.0
# Phone / second-screen companion for the local voice assistant
# (AI_PROVIDER=ollama, docs/REMOTE.md): open http://<pc-ip>:4173/remote.html
# on a phone on the same Wi-Fi. That requires HOST=0.0.0.0, which exposes
# every key-brokering proxy to the LAN (see the WARNING just above) — trusted
# networks only. Typed commands work over plain http; the phone mic needs
# HTTPS or localhost. Replies are spoken on the globe machine, not the phone.
# VOICE_REMOTE_WS_PATH=/api/voice/remote
# Federated globes (AI_PROVIDER=ollama, docs/FEDERATION.md): other instances
# whose spoken alerts this globe repeats ("From <peer>: ...") and that receive
# places you share with share_place. Comma-separated companion-hub URLs
# (ws://host:port/api/voice/remote, or bare host:port). Peers are NOT
# authenticated: trusted LAN hosts only. GEV_PEER_NAME defaults to the hostname.
# GEV_PEERS=ws://192.168.1.51:4173/api/voice/remote
# GEV_PEER_NAME=Desk A

# Optional: NASA FIRMS live active fires. SERVER-SIDE ONLY (never reaches the
# browser — the client polls the /api/firms proxy). Free key:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without a key the FIRMS Active Fires layer is empty ("KEY REQUIRED").
# FIRMS_MAP_KEY=

# Optional: Live AIS vessels layer
# Browser fetch path. Keep same-origin so the private stream key stays server-side.
VITE_AIS_LIVE_API_URL=/api/ais-live
# Client render cap. The server can keep a larger AISStream cache, but drawing
# every global vessel at once can overwhelm WebGL on laptops.
VITE_AIS_LIVE_MAX_ROWS=12000
# Active label cap after screen-space clustering. Labels exist for all rendered
# ships, but only clustered winners are shown to keep text readable.
VITE_AIS_LIVE_LABEL_MAX_ROWS=900
# Private AISStream key for the server-side websocket. Do not prefix with VITE_.
AISSTREAM_API_KEY=
# Optional AISStream subscription filters.
# AISSTREAM_BOUNDING_BOXES=[[[-90,-180],[90,180]]]
# AISSTREAM_MESSAGE_TYPES=PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,ShipStaticData,StaticDataReport
# Feed watchdog: silence (ms) after which the feed is REPORTED stale; the socket
# is recycled at 2.5x that. Default 120000. The watchdog self-arms only for the
# default worldwide subscription — a narrow filter above can be legitimately
# quiet, so set this explicitly (sized for your filter) to opt back in.
# 0 disables the silence watch entirely.
# AISSTREAM_SILENCE_TIMEOUT_MS=120000

# Optional: TomTom live traffic flow (BYOK freemium — free tier is ~50,000 tile
# requests/day, get a key at https://developer.tomtom.com). SERVER-SIDE ONLY:
# the browser fetches same-origin /api/tomtom/* and never sees the key.
# Keyless fallback: the traffic layer runs its built-in simulation (white dots,
# hardcoded per-road-class speeds) — no key required for the layer to work.
# TOMTOM_API_KEY=
# Optional soft cap on upstream tile fetches per UTC day (default 40000) — a
# configurable application safety ceiling, not a guarantee of staying within
# TomTom's free allowance (currently 200K tile requests/month:
# https://docs.tomtom.com/pricing/). Over the cap the proxy serves cached/stale
# tiles instead of hitting upstream.
# TOMTOM_DAILY_TILE_BUDGET=40000

# Optional: CCTV layer tuning (advanced). Defaults are sensible — leave unset
# unless you're customizing the camera source pack.
# CCTV_SOURCES_FILE=config/cctv_sources.austin.json   # path to a source-pack JSON
# CCTV_SOURCES_JSON=                                   # inline source-pack JSON (overrides file)
# CCTV_AUSTIN_ROWS_URL=                                # override the Austin Open Data catalog URL
# CCTV_AUSTIN_MAX_SOURCES=250                          # cap cameras loaded from the Austin catalog
# CCTV_CALTRANS_DISTRICTS=4,7,11,3                     # Caltrans districts; empty string disables Caltrans
# CCTV_CALTRANS_MAX_SOURCES=300                        # cap cameras loaded from Caltrans
# CCTV_TFL_ENABLED=1                                   # set 0 to disable Transport for London JamCams
# CCTV_TFL_MAX_SOURCES=250                             # cap cameras loaded from TfL
# CCTV_ONTARIO_ENABLED=1                               # set 0 to disable Ontario 511 cameras
# CCTV_ONTARIO_MAX_SOURCES=1000                        # cap cameras loaded from Ontario 511
# CCTV_FINTRAFFIC_ENABLED=1                            # set 0 to drop the Fintraffic (Finland) pack
# CCTV_FINTRAFFIC_MAX_SOURCES=300                      # cap cameras loaded from the Fintraffic catalog
# CCTV_DRIVEBC_MAX_SOURCES=250                         # cap DriveBC (British Columbia) cameras, nearest Vancouver/Victoria first
# CCTV_DRIVEBC_ENABLED=1                               # 0 turns off the DriveBC camera pack
# CCTV_TXDOT_ENABLED=1                                 # set 0 to disable the TxDOT (Texas) pack
# CCTV_TXDOT_DISTRICTS=AUS,SAT                         # TxDOT district codes (25 exist); empty disables the pack
# CCTV_TXDOT_MAX_SOURCES=500                           # cap cameras loaded from the TxDOT catalogs
# CCTV_TALLINN_ENABLED=1                               # set 0 to disable the Tallinn (Estonia) intersection cameras
# CCTV_TALLINN_MAX_SOURCES=255                         # cap cameras loaded from the Tallinn catalog
# CCTV_TARKTEE_ENABLED=1                               # set 0 to disable the Tarktee (Estonia) road-weather cameras
# CCTV_TARKTEE_MAX_SOURCES=179                         # cap cameras loaded from Tarktee
# CCTV_WARENDORF_ENABLED=1                             # set 0 to disable the Warendorf (Germany) municipal webcams
# CCTV_NSW_ENABLED=1                                   # set 0 to disable the Live Traffic NSW (Australia) cameras
# CCTV_NSW_MAX_SOURCES=250                             # cap cameras loaded from Live Traffic NSW
# CCTV_CALGARY_ENABLED=1                               # set 0 to disable the Open Calgary (Alberta) cameras
# CCTV_CALGARY_MAX_SOURCES=220                         # cap cameras loaded from the Open Calgary catalog
# CCTV_CALGARY_ROWS_URL=                               # override the Open Calgary catalog URL
# CCTV_MAX_SOURCES=4000                                # catalog-wide cap, shared round-robin across packs (hard ceiling 10000)
# CCTV_PREFER_AUSTIN=1                                 # prioritize Austin cameras in the registry
# CCTV_FORCE_AUSTIN=                                   # force live default sources when a source-pack JSON is configured
# World public-camera pack: static export of 32 open traffic-camera catalogs in 18 countries (see DATA_SOURCES.md for licences):
# CCTV_SOURCES_FILE=config/cctv_sources.world.json   # ~5k world cameras; regenerate with node scripts/export-world-cctv.mjs
# CCTV_FORCE_AUSTIN=1                                  # a configured file pack REPLACES the live packs (Austin, Caltrans, TfL, ...); set 1 to keep them too
# CCTV_MAX_SOURCES=5000                                # default 4000 is below world pack + live packs; ceiling 10000 (excess is trimmed round-robin per pack)
