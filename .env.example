# Every key below is optional. Each layer degrades cleanly when its key is absent;
# the app runs fully keyless with aircraft, satellites, events and NASA imagery.

# Contact details sent in the User-Agent to every upstream. Required by the etiquette
# policies of Nominatim, Overpass and the Wikimedia APIs. Set this before enabling
# the place-search, POI or people layers.
TRACKER_CONTACT_EMAIL=

# Live AIS ship positions. Free key from https://aisstream.io/apikeys (GitHub sign-in).
TRACKER_AISSTREAM_API_KEY=

# Global public webcam directory. Free key from https://api.windy.com/keys
TRACKER_WINDY_API_KEY=

# London traffic cameras (JamCams). Free key from https://api-portal.tfl.gov.uk
TRACKER_TFL_APP_KEY=

# Cesium ion, for the 3D buildings layer only. Free token from https://ion.cesium.com
# Community tier is non-commercial. The buildings layer stays off without this.
TRACKER_CESIUM_ION_TOKEN=
