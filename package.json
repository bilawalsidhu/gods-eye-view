{
  "name": "gods-eye-view",
  "private": true,
  "version": "0.1.1",
  "description": "A real-time intelligence console for planet Earth \u2014 photorealistic 3D globe, live aircraft/ships/satellites/earthquakes/CCTV, and hands-free voice control. Runs in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "Bilawal Sidhu",
  "homepage": "https://github.com/bilawalsidhu/gods-eye-view#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bilawalsidhu/gods-eye-view.git"
  },
  "bugs": {
    "url": "https://github.com/bilawalsidhu/gods-eye-view/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "doctor": "node scripts/setup-doctor.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "dev": "vite",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs",
    "check:boundaries": "node scripts/check-package-boundaries.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  },
  "exports": {
    "./infrastructure": "./src/data/infrastructure.js",
    "./infrastructure/geojson": "./src/data/localGeojsonCore.js",
    "./infrastructure/lod": "./src/data/localGeojsonLod.js",
    "./application": "./src/app/application.js",
    "./application/viewer": "./src/app/viewer.js",
    "./build/vite": {
      "node": "./build/vite.js"
    },
    "./server/providers/live": {
      "node": "./server/providers/live.js"
    },
    "./sources/adsb-lol": "./src/data/adsbLolFallback.js",
    "./server/providers/places": {
      "node": "./server/providers/places.js"
    },
    "./sources/places": "./src/data/placeProviderPayloads.js",
    "./server/providers/space": {
      "node": "./server/providers/space.js"
    },
    "./sources/space": "./src/data/spaceProviderRequests.js",
    "./server/providers/terrain": {
      "node": "./server/providers/terrain.js"
    },
    "./sources/terrain": "./src/data/terrainHeightsProxy.js",
    "./server/providers/traffic": {
      "node": "./server/providers/traffic.js"
    },
    "./sources/traffic": "./src/data/tomtomTiles.js",
    "./server/providers/firms": {
      "node": "./server/providers/firms.js"
    },
    "./server/providers/gbfs": {
      "node": "./server/providers/gbfs.js"
    },
    "./sources/gbfs": "./src/data/gbfsSource.js",
    "./server/providers/cctv": {
      "node": "./server/providers/cctv.js"
    },
    "./server/providers/radio": {
      "node": "./server/providers/radio.js"
    }
  }
}
