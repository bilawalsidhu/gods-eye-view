{
  "name": "gods-eye-view",
  "private": true,
  "version": "0.10.2",
  "description": "A real-time intelligence console for planet Earth \u2014 photorealistic 3D globe, live aircraft/ships/satellites/earthquakes/CCTV, and hands-free voice control. Runs in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "Bilawal Sidhu",
  "homepage": "https://github.com/bilawalsidhu/gods-eye-view#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bilawalsidhu/gods-eye-view.git"
  },
  "bugs": {
    "url": "https://github.com/bilawalsidhu/gods-eye-view/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "overrides": {
    "@cesium/engine": "26.2.0",
    "@cesium/widgets": "16.1.1"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "dev": "vite",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "node scripts/copy-cesium-assets.mjs && node scripts/build.mjs",
    "check:budgets": "node scripts/check-bundle-budgets.mjs",
    "check:audit": "node scripts/check-prod-audit.mjs",
    "build:wasm": "wasm-pack build rust/firms-renderer --target web --release --out-dir ../../public/wasm/firms-renderer --out-name firms_renderer",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/run-unit-tests.mjs",
    "test:coverage": "c8 --lines 91 --statements 91 --functions 91 --branches 82 node scripts/run-unit-tests.mjs --parallel-only",
    "test:track": "node scripts/track-regression.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs",
    "qa:all": "node scripts/qa-all.mjs"
  },
  "c8": {
    "reporter": [
      "text"
    ],
    "include": [
      "src/**/*.js",
      "functions/**/*.js"
    ],
    "exclude": [
      "**/*.test.mjs"
    ]
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "1.144.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@zip.js/zip.js": "^2.7.44",
    "axe-core": "^4.13.0",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^64.5.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "^17.11.0",
    "puppeteer": "^25.11.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "ws": "^8.21.0"
  }
}
