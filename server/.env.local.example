NODE_ENV=development
HOST=127.0.0.1
PORT=3000
STATIC_ROOT=dist
LOG_LEVEL=debug

# DefaultAzureCredential uses Azure CLI locally and managed identity in ACA.
# Set AZURE_CLIENT_ID only when selecting a particular local/user-assigned identity.
AZURE_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=

AZURE_MAPS_ENDPOINT=https://atlas.microsoft.com
AZURE_MAPS_CLIENT_ID=

FOUNDRY_ENDPOINT=
FOUNDRY_REALTIME_DEPLOYMENT=
FOUNDRY_HUD_DEPLOYMENT=

AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
# Local-only secret; never commit a value. ACA uses a Key Vault reference.
AISSTREAM_API_KEY=
AISSTREAM_BOUNDING_BOXES=[[[-90,-180],[90,180]]]
AISSTREAM_MESSAGE_TYPES=["PositionReport","StandardClassBPositionReport","ExtendedClassBPositionReport","ShipStaticData","StaticDataReport"]
AISSTREAM_SILENCE_TIMEOUT_MS=120000
AISSTREAM_RECYCLE_MS=300000

# Optional during local development. Mandatory in production.
COMPATIBILITY_MODULE_PATH=
