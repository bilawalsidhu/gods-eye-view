/**
 * Example user layer. Copy to `example.layer.js` (or any `*.layer.js` name)
 * and edit — the copy is gitignored. See README.md for the full contract.
 */
export default {
  id: 'example-points',
  label: 'Example Points',
  createLayer: () => {
    let enabled = false;
    return {
      id: 'example-points',
      name: 'Example Points',
      icon: '*',
      // Required. The manager calls this once before the first enable and does
      // not check that it exists — a layer without one can never switch on.
      async init() {
        // Build entities, load a dataset, resolve a provider here.
      },
      enable() {
        enabled = true;
      },
      disable() {
        enabled = false;
      },
      async update() {
        if (!enabled) return;
        // Fetch and draw here.
      },
    };
  },
};
