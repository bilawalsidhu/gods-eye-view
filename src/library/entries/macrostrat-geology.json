{
  "id": "macrostrat-geology",
  "kind": "tiles",
  "family": "environment",
  "title": "Geologic map (Macrostrat)",
  "provider": "Macrostrat",
  "description": "Bedrock geology worldwide, harmonised from hundreds of published geologic maps and coloured by rock age on the international (ICS) time-scale colours.",
  "icon": "◒",
  "maintainer": "github:asturksever",
  "coverage": {
    "global": true
  },
  "source": {
    "format": "xyz",
