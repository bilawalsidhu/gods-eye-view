      },
      {
        "label": "Minimum depth 20–30 m",
        "color": "#c7f2ff"
      },
      {
        "label": "Minimum depth 30–40 m",
        "color": "#c3f1ff"
      },
      {
        "label": "Minimum depth 40–50 m",
        "color": "#bdefff"
      },
      {
        "label": "Minimum depth 50–100 m",
        "color": "#b8edff"
      },
      {
        "label": "Minimum depth 100–150 m",
