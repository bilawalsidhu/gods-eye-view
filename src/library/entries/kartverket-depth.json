{
  "id": "kartverket-depth",
  "kind": "tiles",
  "family": "environment",
  "title": "Norway sea depths (Kartverket)",
  "provider": "Kartverket",
  "description": "Kartverket's depth areas and depth contours of Norwegian waters, shown from coastal scale (zoom in to see them).",
  "icon": "≋",
  "maintainer": "github:asturksever",
  "coverage": {
    "countries": ["NO"],
    "bbox": [3.7, 57.6, 32, 71.6]
  },
  "source": {
    "format": "bbox",
    "url": "https://wms.geonorge.no/skwms1/wms.dybdedata2?service=WMS&request=GetMap&version=1.3.0&layers=Dybdelag,Dybdekontur&styles=&crs=EPSG:3857&bbox={bbox-epsg-3857}&width=256&height=256&format=image/png&transparent=true",
    "fetch": "browser-direct",
    "cacheSeconds": 86400,
    "minZoom": 11,
    "maxZoom": 20,
    "bounded": true
  },
  "display": {
    "opacity": 1,
    "legend": [
      {
        "label": "Minimum depth 0–5 m",
        "color": "#e6ffff"
      },
      {
        "label": "Minimum depth 5–10 m",
        "color": "#dbfaff"
      },
      {
        "label": "Minimum depth 10–20 m",
