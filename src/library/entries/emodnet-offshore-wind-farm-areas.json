{
  "id": "emodnet-offshore-wind-farm-areas",
  "kind": "dataset",
  "family": "infrastructure",
  "title": "Offshore wind farm areas, European seas (EMODnet)",
  "provider": "EMODnet",
  "description": "Outlines of about 600 offshore wind farms and development zones in European seas from EMODnet, from planned to dismantled, with capacity in MW where known. Coloured by status. Farms EMODnet holds only as points are in the sites entry.",
  "icon": "✣",
  "maintainer": "github:Herr-Enklo",
  "coverage": {
    "countries": [
      "BE",
      "DE",
      "DK",
      "EE",
      "ES",
      "FI",
      "FR",
      "GB",
      "IE",
      "LT",
      "LV",
      "NL",
      "PL",
      "PT",
      "SE"
    ],
    "bbox": [-17, 27, 25, 66]
  },
  "source": {
    "format": "geojson",
    "url": "https://ows.emodnet-humanactivities.eu/wfs",
    "query": {
      "service": "WFS",
      "version": "2.0.0",
      "request": "GetFeature",
      "typeName": "emodnet:windfarmspoly",
      "outputFormat": "application/json"
    },
    "fetch": "browser-direct",
    "cacheSeconds": 86400,
    "maxBytes": 8388608,
    "maxFeatures": 2000
  },
  "display": {
    "color": "#a0aec0",
    "label": "name",
    "fields": ["power_mw", "n_turbines", "status", "country"],
    "colorBy": {
      "field": "status",
      "colors": {
        "Production": "#0ca30c",
        "Construction": "#fab219",
        "Approved": "#63b3ed",
        "Planned": "#a0aec0",
        "Test site": "#b794f4",
        "Dismantled": "#718096"
      }
    }
  },
  "licence": {
    "name": "CC BY 4.0 (EMODnet Human Activities)",
    "url": "https://creativecommons.org/licenses/by/4.0/"
  },
  "attribution": {
    "text": "EMODnet Human Activities (data originator CETMAR), CC BY 4.0",
    "url": "https://emodnet.ec.europa.eu/en/human-activities"
  },
  "status": "community",
  "reviewed": "2026-11-17"
}
