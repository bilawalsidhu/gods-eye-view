  "maintainer": "github:Herr-Enklo",
  "coverage": {
    "global": true
  },
  "source": {
    "format": "xyz",
    "url": "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/GHRSST_L4_MUR_Sea_Surface_Temperature/default/default/GoogleMapsCompatible_Level7/{z}/{y}/{x}.png",
    "fetch": "browser-direct",
    "cacheSeconds": 21600,
    "minZoom": 0,
    "maxZoom": 7
  },
  "display": {
