{
  "id": "gibs-sea-surface-temperature",
  "kind": "tiles",
  "family": "environment",
  "title": "Sea surface temperature, daily (NASA MUR)",
  "provider": "NASA GIBS",
  "description": "Daily global sea surface temperature at 1 km from the GHRSST Level 4 MUR analysis (NASA JPL), which blends several satellites and buoys so clouds leave no gaps. The newest field is about a day old.",
