# Cloudflare Pages — environment variables
# Add these via the Cloudflare Pages dashboard → Settings → Environment variables.
# Secrets (marked *) must be added as _vars or via wrangler secret put.
#
# For local development with `npm run dev`, copy this file to .env and fill in values.
# For production, set these in the Cloudflare Pages dashboard.

# ─── Browser-exposed (via import.meta.env.VITE_*) ────────────────────────────────
# These are baked into the browser bundle at build time.
# RESTRICT these keys in the provider dashboard (HTTP referrer, API restrictions).

# Required: Google Maps API key (Maps 3D Tiles API must be enabled).
# CLIENT-EXPOSED — restrict in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Cesium ion token for Bing imagery and Cesium World Terrain.
# CLIENT-EXPOSED — use a public assets:read token with URL restrictions.
VITE_CESIUM_ION_TOKEN=

# Optional: AIS live layer — set to your Cloudflare Workers AIS endpoint in production.
# Local dev defaults to /api/ais-live (Vite proxy). Workers production URL would be:
# https://geoview.your-worker.workers.dev/ais-live
# VITE_AIS_LIVE_API_URL=/api/ais-live

# Client render cap for AIS layer (default 12000).
# VITE_AIS_LIVE_MAX_ROWS=12000

# Active label cap after screen-space clustering (default 900).
# VITE_AIS_LIVE_LABEL_MAX_ROWS=900

# ─── Server-side (Cloudflare Workers only — never in the browser bundle) ────────

# OpenAI Realtime voice control.
# Set via: wrangler secret put OPENAI_API_KEY
OPENAI_API_KEY=

# OpenAI voice model config.
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_CONTEXT_TOKENS=3000
OPENAI_REALTIME_CONTEXT_RETENTION=0.5
OPENAI_HUD_SUMMARY_MODEL=gpt-5-nano

# OpenSky auth credentials (for the OpenSky Worker).
# Set via: wrangler secret put OPENSKY_CLIENT_ID / OPENSKY_CLIENT_SECRET
# OPENSKY_AUTH_MODE=oauth
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# NASA FIRMS API key (for the FIRMS Worker).
# Set via: wrangler secret put FIRMS_MAP_KEY
# FIRMS_MAP_KEY=

# TomTom API key (for the TomTom Worker).
# Set via: wrangler secret put TOMTOM_API_KEY
# TOMTOM_API_KEY=

# AISStream private key (for the AIS Durable Object Worker).
# Set via: wrangler secret put AISSTREAM_API_KEY
# AISSTREAM_API_KEY=

# ─── KV Namespace Bindings (configured in wrangler.toml) ─────────────────────
# CACHE_KV = KV namespace for API response caching
# CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN set in GitHub Secrets
