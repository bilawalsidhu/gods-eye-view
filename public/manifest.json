{
  "name": "God's Eye View",
  "short_name": "GEV",
  "description": "Real-time geospatial intelligence console — live aircraft, ships, satellites, fires, and more on a 3D globe",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["navigation", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Aircraft Tracking",
      "short_name": "Flights",
      "description": "View live aircraft positions",
      "url": "/#layer=flights",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Fire Detection",
      "short_name": "Fires",
      "description": "View NASA FIRMS fire detections",
      "url": "/#layer=fires",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Vessel Tracking",
      "short_name": "Vessels",
      "description": "View live AIS vessel positions",
      "url": "/#layer=ais-live-vessels",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
