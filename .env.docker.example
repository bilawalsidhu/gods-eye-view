# All provider keys are optional. Copy this file to .env next to compose.yaml.
# Private keys stay on the server. Never commit this file with real keys.
# For the full provider list and advanced options, see .env.example.

# Set this to the image published by your repository owner.
GEV_IMAGE=ghcr.io/bilawalsidhu/gods-eye-view:latest
GEV_PORT=4173

# Public browser credentials. Restrict these keys at the provider.
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=

# Private server credentials.
OPENAI_API_KEY=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
TOMTOM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
LL2_API_TOKEN=
