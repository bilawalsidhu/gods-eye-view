.cache/
# Browser QA gate evidence (screenshots, console and network dumps).
qa-artifacts/
# Playwright MCP session logs: browser consoles can carry tokens in URLs.
.playwright-mcp/
# Local Claude Code settings and preview configs.
.claude/
.DS_Store
pinokio/ENVIRONMENT
pinokio/.installed

# Fork-only package boundary additions (npm run check:boundaries -- --local).
scripts/package-boundaries.local.json
