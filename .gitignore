node_modules
dist
# Credential files. `.env` alone is not enough: Vite's loadEnv (vite.config.js,
# scripts/read-dotenv-value.mjs) reads the full dotenv ladder — .env,
# .env.local, .env.<mode> and .env.<mode>.local — so a key placed in any of
# them is live for the app. Only .env was ignored, leaving the other three
# committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.wrangler/
.gev-cache/
.DS_Store
.gstack/
3d-models/
rust/firms-renderer/target/
coverage/
