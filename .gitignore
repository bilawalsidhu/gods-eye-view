# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
# Browser QA gate evidence (screenshots, console and network dumps).
qa-artifacts/
# Personal public-data snapshots are installed locally, not contribution files.
public/infrastructure/
# Never commit captured camera photos, derivatives or personal research notes.
private-images/
# Operator-supplied GDOT metadata and private validation/browser output.
config/cctv_sources.georgia511.json
browser-profiles/
.DS_Store
.gstack/
3d-models/
pinokio/ENVIRONMENT
pinokio/.installed
verification/
.gev-private/
.local-state/
credential-isolation/

