# Credential files: Vite's loadEnv (server/standalone/vite.config.js) and
# scripts/setup-doctor.mjs read .env, .env.local, .env.<mode> and .env.<mode>.local.
# .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
